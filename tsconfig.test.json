{
  // テストは Cloudflare Workers ではなく Node で走るので、
  // workers-types に加えて Node の型が要る。本体の tsconfig に
  // @types/node を足すと Worker 側のコードから fs や process が
  // 見えてしまい、エッジで動かないコードが型検査を通ってしまう。
  // 型の見える範囲を分けるために別ファイルにしている。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"]
  },
  // scripts/ も Node 側。configs/ の生成物を作る場所で、
  // ドリフト検査テストがここから import するので型検査の対象に含める。
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
