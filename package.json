{
  "name": "qaiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QAIZ — Quantitative Analyst Intelligence Zone: 地域×セクターの株式をバリュエーション・クオリティ・成長・テクニカル・リスク・アナリストコンセンサスで横断分析する Cloudflare Workers 製ダッシュボード",
  "scripts": {
    "dev": "wrangler dev",
    "dev:mock": "node dev/mock-server.mjs",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "export:shared": "node scripts/export-shared.ts",
    "lab:test": "cd lab && python -m pytest -q",
    "lab:doctor": "cd lab && python -m qaiz_lab.cli doctor"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
